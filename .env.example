# ─────────────────────────────────────────────────────────────────────────────
# PARMS — Environment Variables
# Copy this file to .env and fill in your values.
# The .env file is gitignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────
# Generate a strong key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to True for local development only. NEVER True in production.
DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=127.0.0.1,localhost

# Required in production (Django 4.0+) — your Render URL(s), comma-separated
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Database ──────────────────────────────────────────────────────────────────
# OPTION A — Production (Render sets this automatically via linked database)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# OPTION B — Quick local dev without a local PostgreSQL install
# USE_SQLITE_FOR_TESTING=True

# OPTION C — Local PostgreSQL (default when DATABASE_URL is not set)
DB_NAME=parking_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432
